<Window x:Class="ScreenAssistant.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up ScreenAssistant"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5882FF" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Card" Color="#1B1E2B"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA3B2"/>

        <!-- Primary (gradient) button -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#12141C" BorderBrush="#2A2E3F"
            BorderThickness="1" Padding="0">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (drag to move + close) -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="22,18,18,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="26" CornerRadius="7"
                            Background="{StaticResource Accent}" Margin="0,0,10,0">
                        <TextBlock Text="🔍" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Set up ScreenAssistant" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CloseBtn" Content="✕" HorizontalAlignment="Right"
                        Style="{StaticResource Ghost}" Padding="10,4" Click="Cancel_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,14,22,20">
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Text="Choose how ScreenAssistant should answer. You can change this later from the tray menu."/>

                <!-- Choice cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CloudCard" Grid.Column="0" Click="ChooseCloud_Click"
                            Cursor="Hand" BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="12" Background="{StaticResource Card}"
                                        BorderBrush="#2A2E3F" BorderThickness="2" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="☁" FontSize="26" Foreground="White"/>
                                        <TextBlock Text="Free Cloud" Foreground="White"
                                                   FontSize="15" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Text="No install. Answers come from a free online model. Needs internet."/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="LocalCard" Grid.Column="2" Click="ChooseLocal_Click"
                            Cursor="Hand" BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="12" Background="{StaticResource Card}"
                                        BorderBrush="#2A2E3F" BorderThickness="2" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="💻" FontSize="26" Foreground="White"/>
                                        <TextBlock Text="Local &amp; Private" Foreground="White"
                                                   FontSize="15" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Text="Installs a small model on this PC. Fully offline and unlimited."/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- CLOUD panel -->
                <StackPanel x:Name="CloudPanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="Free cloud API key"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"
                               Margin="0,4,0,8">
                        <Run Text="A key may already be built in. If not, get a free one at "/>
                        <Hyperlink x:Name="KeyLink" RequestNavigate="Link_Navigate"
                                   NavigateUri="https://console.groq.com/keys">
                            <Run Text="console.groq.com/keys"/>
                        </Hyperlink>
                        <Run Text=" and paste it below."/>
                    </TextBlock>
                    <TextBox x:Name="KeyBox" Background="#1B1E2B" Foreground="White"
                             BorderBrush="#2A2E3F" BorderThickness="1" Padding="10,8"
                             CaretBrush="White" FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="TestBtn" Content="Test key" Style="{StaticResource Ghost}"
                                Click="TestKey_Click"/>
                        <TextBlock x:Name="CloudStatus" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- LOCAL panel -->
                <StackPanel x:Name="LocalPanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="Local model (Ollama)"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"
                               Margin="0,4,0,8"
                               Text="ScreenAssistant will install Ollama (if needed) and download the qwen2.5:1.5b model (~1 GB). This runs entirely on your PC."/>
                    <ProgressBar x:Name="LocalBar" Height="4" IsIndeterminate="False"
                                 Visibility="Collapsed" Background="#1B1E2B"
                                 Foreground="#8B5CF6" BorderThickness="0"/>
                    <TextBlock x:Name="LocalStatus" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel" Style="{StaticResource Ghost}" Click="Cancel_Click"
                            Margin="0,0,10,0"/>
                    <Button x:Name="ContinueBtn" Content="Continue" Style="{StaticResource Primary}"
                            IsEnabled="False" Click="Continue_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
